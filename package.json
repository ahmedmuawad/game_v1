{
  "name": "livi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "export:avatar": "cd tools/avatar && python3 export_layers.py --out ../../public/avatar --view full --preset demo",
    "export:avatar:full": "cd tools/avatar && python3 export_layers.py --out ../../public/avatar --view full --preset full",
    "shot": "node tools/qa/screenshot.mjs",
    "bundle": "vite build && node tools/qa/bundle.mjs",
    "story:check": "node tools/qa/story-run.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
