{
  "id": "s1_c3", "seasonId": "s1", "index": 3,
  "title": { "ar": "اللي محدش قاله", "en": "What Nobody Said" },
  "teaser": { "ar": "كلمة واحدة على لوحة المدرسة، ومحدش عارف مين كتبها.", "en": "One line on the school board, and nobody knows who wrote it." },
  "start": "open",
  "nodes": {
    "open": { "id": "open", "type": "stage", "bg": "classroom", "mood": "tense", "cast": ["player", "salma"], "next": "n1" },
    "n1": { "id": "n1", "type": "narrate", "next": "n2",
      "text": { "ar": "سلمى قاعدة في مكانها من قبل ما ييجي حد. حاطة الشنطة على الترابيزة وحاضنة نفسها.",
                "en": "Salma is in her seat before anyone else arrives, bag on the desk, arms folded around herself." } },
    "n2": { "id": "n2", "type": "say", "who": "salma", "emote": "sad", "next": "n3",
      "text": { "ar": "قالولي. كل الناس عرفت قبلي.", "en": "They told me. Everyone knew before I did." } },
    "n3": { "id": "n3", "type": "say", "who": "salma", "emote": "sad", "next": "c1",
      "text": { "ar": "«بتقلّد نور عشان عايزة تبقى زيها.» … كده. مكتوبة بخط كبير.",
                "en": "\"She copies Nour because she wishes she were her.\" … That. In big letters." } },

    "c1": { "id": "c1", "type": "choice",
      "prompt": { "ar": "إنتِ هتعملي إيه؟", "en": "What do you do?" },
      "options": [
        { "id": "c1_sit", "to": "sit1",
          "text": { "ar": "تقعدي جنبها من غير كلام.", "en": "Sit beside her without saying anything." },
          "hint": { "ar": "وجود", "en": "Presence" },
          "effects": [{ "trait": "empathy", "delta": 7 }, { "rel": "salma", "delta": 9 }] },
        { "id": "c1_angry", "to": "ang1",
          "text": { "ar": "«مين اللي كتبها؟ أنا هعرف.»", "en": "\"Who wrote it? I'll find out.\"" },
          "hint": { "ar": "غضب", "en": "Anger" },
          "effects": [{ "trait": "confidence", "delta": 6 }, { "flag": "vowed_find", "value": true }] },
        { "id": "c1_deny", "to": "den1",
          "text": { "ar": "«وإنتِ مش بتقلّدي حد. أنا شايفة الفرق.»", "en": "\"You don't copy anyone. I can see the difference.\"" },
          "hint": { "ar": "طمأنة", "en": "Reassurance" },
          "effects": [{ "trait": "empathy", "delta": 5 }, { "rel": "salma", "delta": 6 }, { "flag": "reassured", "value": true } ] }
      ] },

    "sit1": { "id": "sit1", "type": "narrate", "next": "hall",
      "text": { "ar": "قعدتوا كده لحد ما الجرس رنّ. ما قالتش حاجة، بس قرّبت كرسيها شوية.",
                "en": "You sat like that until the bell. She didn't speak, but she moved her chair a little closer." } },
    "ang1": { "id": "ang1", "type": "say", "who": "salma", "emote": "surprised", "next": "hall",
      "text": { "ar": "متعمليش كده. ده هيبقى أسوأ.", "en": "Don't do that. It'll only get worse." } },
    "den1": { "id": "den1", "type": "say", "who": "salma", "emote": "neutral", "next": "hall",
      "text": { "ar": "طب ليه أنا نفسي مش متأكدة؟", "en": "Then why am I the one who isn't sure?" } },

    "hall": { "id": "hall", "type": "stage", "bg": "corridor", "mood": "cool", "cast": ["player", "nour"], "next": "h1" },
    "h1": { "id": "h1", "type": "say", "who": "nour", "emote": "neutral", "next": "h2",
      "text": { "ar": "سمعت. وقبل ما تسأليني — لأ، مش أنا.", "en": "I heard. And before you ask — no, it wasn't me." } },
    "h2": { "id": "h2", "type": "choice",
      "options": [
        { "id": "h2_believe", "to": "h3a",
          "text": { "ar": "«أنا مصدّقاكِ.»", "en": "\"I believe you.\"" },
          "effects": [{ "rel": "nour", "delta": 10 }, { "trait": "empathy", "delta": 3 }, { "flag": "trust_nour", "value": true }] },
        { "id": "h2_press", "to": "h3b",
          "text": { "ar": "«أنا ما سألتش. إنتِ اللي بتردّي.»", "en": "\"I didn't ask. You're the one answering.\"" },
          "effects": [{ "trait": "wits", "delta": 7 }, { "rel": "nour", "delta": -4 }, { "flag": "suspect_nour", "value": true }] },
        { "id": "h2_hard", "to": "h3b",
          "text": { "ar": "«يبقى ساعديني أعرف مين.»", "en": "\"Then help me find out who.\"" },
          "when": { "trait": "confidence", "op": ">=", "value": 18 },
          "lockedHint": { "ar": "محتاجة ثقة أكتر", "en": "You need more confidence" },
          "effects": [{ "rel": "nour", "delta": 6 }, { "trait": "confidence", "delta": 4 }, { "flag": "nour_ally", "value": true }] }
      ] },
    "h3a": { "id": "h3a", "type": "say", "who": "nour", "emote": "sad", "next": "dina_sc",
      "text": { "ar": "شكراً. مش كتير بيعملوا كده.", "en": "Thanks. Not many people do that." } },
    "h3b": { "id": "h3b", "type": "say", "who": "nour", "emote": "thinking", "next": "dina_sc",
      "text": { "ar": "طيب. أنا كمان عايزة أعرف.", "en": "Alright. I want to know too." } },

    "dina_sc": { "id": "dina_sc", "type": "stage", "cast": ["player", "dina"], "next": "d1" },
    "d1": { "id": "d1", "type": "say", "who": "dina", "emote": "neutral", "next": "d2",
      "text": { "ar": "إنتِ لسه بتدوّري.", "en": "You're still looking." } },
    "d2": { "id": "d2", "type": "choice",
      "options": [
        { "id": "d2_ask", "to": "d3",
          "text": { "ar": "«قوليلي. سلمى صاحبتي.»", "en": "\"Tell me. Salma is my friend.\"" },
          "effects": [{ "rel": "dina", "delta": -3 }, { "flag": "pressed_dina", "value": true }] },
        { "id": "d2_wait", "to": "d4",
          "text": { "ar": "«مش هضغط عليكِ. لما تكوني جاهزة.»", "en": "\"I won't push. When you're ready.\"" },
          "effects": [{ "rel": "dina", "delta": 12 }, { "trait": "empathy", "delta": 6 }, { "flag": "dina_trusts", "value": true }] },
        { "id": "d2_smart", "to": "d4",
          "text": { "ar": "«إنتِ مش خايفة منها. إنتِ خايفة عليها.»", "en": "\"You're not afraid of her. You're afraid *for* her.\"" },
          "when": { "trait": "wits", "op": ">=", "value": 20 },
          "lockedHint": { "ar": "محتاجة تلاحظي أكتر", "en": "You need to notice more" },
          "effects": [{ "rel": "dina", "delta": 15 }, { "trait": "wits", "delta": 5 },
                      { "flag": "dina_trusts", "value": true }, { "flag": "guessed_close", "value": true }] }
      ] },
    "d3": { "id": "d3", "type": "say", "who": "dina", "emote": "sad", "next": "fin",
      "text": { "ar": "لو قلت، حاجة هتتكسر. وأنا مش قادرة أكسرها.",
                "en": "If I say it, something breaks. And I can't be the one who breaks it." } },
    "d4": { "id": "d4", "type": "say", "who": "dina", "emote": "neutral", "next": "d5",
      "text": { "ar": "هي ما كانتش قاصدة توصل لكده. صدقيني.",
                "en": "She didn't mean for it to go this far. Believe me." } },
    "d5": { "id": "d5", "type": "narrate", "next": "fin",
      "text": { "ar": "«هي». يعني بنت. يعني حد إنتِ عارفاه.", "en": "\"She.\" So it's a girl. So it's someone you know." } },

    "fin": { "id": "fin", "type": "end",
      "reward": { "coins": 160, "xp": 65 },
      "nextChapter": "s1_c4",
      "teaser": { "ar": "بكرة البروفة. وكل الناس هتبقى في أوضة واحدة.",
                  "en": "Tomorrow is rehearsal. And everyone will be in one room." } }
  }
}
